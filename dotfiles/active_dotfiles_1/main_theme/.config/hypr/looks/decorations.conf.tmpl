general {
   gaps_in = {{ .root.misc.gaps_in }}
   gaps_out = {{ .root.misc.gaps_out }}

   border_size = {{ .root.misc.border_size }}

   col.active_border = rgba({{ strings.TrimPrefix "#" .root.colors.gui.main.primary }}FF)
   col.inactive_border = rgba({{ strings.TrimPrefix "#" .root.colors.gui.main.secondary }}FF)
}

decoration {
   rounding = {{ .root.misc.border_rounding }}
   rounding_power = 3

   active_opacity = 1.0
   inactive_opacity = 0.85

   dim_inactive = true
   dim_strength = 0.1

   shadow {
      enabled = true
      range = 5
      render_power = 3
      color = rgba({{ strings.TrimPrefix "#" .root.colors.gui.main.background }}ee)
   }

   blur {
      enabled = true
      size = 5
      passes = 4
      noise = 0.06
      vibrancy = 0.19
      vibrancy_darkness = 1
      brightness = 1.1
      popups = true
      special = true
   }
}


windowrule = opacity 0.9 0.8, match:class kitty

layerrule = blur on, ignore_alpha 0.1, match:namespace rofi
layerrule = blur on, ignore_alpha 0.7, match:namespace waybar
