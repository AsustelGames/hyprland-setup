* {
   background-color: transparent;
   text-color: #F9F5F4;
   padding: 0px;
   border-radius: 8px;
}

window {
   background-color: none;
   location: center;
   width: 30%;
}

mainbox {
   spacing: 15px;

   children: [ message, listview ];
}

listview {
   background-color: #1827287d;
   border-color: #CAD277;
   padding: 3px;
   lines: 1;
   columns: 3;
   border: 3px;
   horizontal-align: 0.5;
}

element {
   padding: 7px;
}

element selected {
   background-image: linear-gradient(45deg, #CAD277, #A2B057);
   border-radius: 5px;
}

element-icon {
   padding: 5px;
   size: 30px;
}

element-text {
   padding: 5px;
   vertical-align: 0.5;
   font: "MartianMono Nerd Font 12";
}

textbox-current-entry, message {
   background-color: #1827287d;
   border-color: #A2B057;
   padding: 20px 15px;
   horizontal-align: 0.5;
   border: 3px;
}
