* {
   background-color: transparent;
   text-color: #F9F5F4;
   padding: 0px;
   border-radius: 8px;
}

window {
   background-color: none;
   location: center;
   width: 30%;
}

mainbox {
   spacing: 15px;

   children: [ inputbar, listview, message ];
}

textbox-prompt-colon {
   background-image: linear-gradient(45deg,#CAD277,#A2B057);
   text-color: #F9F5F4;
   padding: 5px 20px;
   expand: false;
   str: "";
}

inputbar {
   background-image: url("~/.config/rofi/bg.png", none);
   padding: 10px;
   border-color: #CAD277;
   border: 3px;

   children: [ "textbox-prompt-colon", "entry" ];
}

entry {
   placeholder-color: #F9F5F4;
   padding: 0px 10px;
   vertical-align: 0.5;
   placeholder: "Search...";
   border-radius: 0px;
}

listview {
   background-color: #1827287d;
   border-color: #A2B057;
   padding: 3px;
   lines: 8;
   columns: 1;
   fixed-columns: true;
   border: 3px;
}

element {
   padding: 7px;
}

element selected {
   background-image: linear-gradient(45deg, #CAD277, #A2B057);
   border-radius: 5px;
}

element-icon {
   padding: 5px;
   size: 30px;
}

element-text {
   padding: 5px;
   vertical-align: 0.5;
   font: "MartianMono Nerd Font 12";
}

textbox-current-entry, message, error-message {
   background-color: #1827287d;
   border-color: #A2B057;
   padding: 10px 15px;
   horizontal-align: 0.5;
   border: 3px;
}
