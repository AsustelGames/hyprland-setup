// -*- mode: jsonc -*-

{
    "position": "top",
    "mode": "dock",
    "margin-top": 10,
    "margin-left": 10,
    "margin-right": 10,
    "height": 40,
    "spacing": 5,


    "modules-left": [
        "custom/start",
        "hyprland/workspaces"
    ],
    "modules-center": [
        "custom/cava"
    ],
    "modules-right": [
        "custom/power-profiles",
        "bluetooth",
        "pulseaudio",
        "network",
        "tray",
        "clock",
        "battery"
    ],
	 "custom/start": {
        "format": "",
        "tooltip-format": "menu",
        "on-click": "bash ~/.config/scripts/menu.sh"
    },
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "warp-on-scroll": false,
        "format": "{name}"
    },
    "custom/cava": {
        "format": "{}",
        "exec": "~/.config/scripts/waybar/cava.sh"
    },
    "custom/power-profiles": {
        "exec": "bash ~/.config/scripts/waybar/power-profiles.sh",
        "interval": 1,
        "format": {},
        "tooltip-format": "",

        "on-click": "bash ~/.config/scripts/menu.sh -P"

    },
    "bluetooth": {
        "format": " {status}",
        "format-no-controller": "",
        "format-connected": "󰂲 connected",
        "format-connected-battery": " connected {battery}%",
        "on-click": "hyprctl dispatch exec '[float]' bash ~/.config/scripts/kitty.sh bluetui"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "󰂰 {volume}%",
        "format-bluetooth-muted": "󰂰 muted",
        "format-muted": " muted",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "hyprctl dispatch exec '[float]' bash ~/.config/scripts/kitty.sh wiremix"
    },
    "network": {
        "format-wifi": "󰖩 on",
        "format-ethernet": "󰈀 on",
        "format-disconnected": "󰖪 off",

        "on-click": "hyprctl dispatch exec '[float]' bash ~/.config/scripts/kitty.sh sudo nmtui &"
    },
    "tray": {
    },
    "clock": {
        "interval": 1,
        "timezone": "Europe/Zurich",
        "format": " {:%I:%M %p}",
        "format-alt": " {:%I:%M:%S %p, %b %d, %a, %d.%m.%Y}",
        "tooltip-format": " {:%I:%M:%S %p eu(%H:%M:%S), %b %d, %a, eu(%d.%m.%Y) us(%m.%d.%Y)}"
    },
    "battery": {
        "format": "{icon} {capacity}%",
        "format-full": "{icon} {capacity}%",
        "format-charging": "󱐋 {capacity}%",
        "format-plugged": "󱐋 {capacity}%",

        "format-icons": ["󱟩", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    }
}
