// -*- mode: jsonc -*-

{
   "position": "top",
   "mode": "dock",
   "margin-top": 10,
   "margin-left": 10,
   "margin-right": 10,
   "height": 40,
   "spacing": 5,


   "modules-left": [
      "custom/start",
      "hyprland/workspaces"
   ],
   "modules-center": [
      "custom/cava"
   ],
   "modules-right": [
      "custom/power-profiles",
      "bluetooth",
      "pulseaudio",
      "network",
      "tray",
      "clock",
      "battery"
   ],
   "custom/start": {
      "format": "",
      "tooltip-format": "menu",
      "on-click": "bash $HOME/.config/scripts/menu.sh",
      "return-type": "json"
   },
   "hyprland/workspaces": {
      "disable-scroll": true,
      "all-outputs": true,
      "warp-on-scroll": false,
      "format": "{name}"
   },
   "custom/cava": {
      "format": "{}",
      "exec": "$HOME/.config/scripts/waybar/cava.sh",
      "return-type": "json"
   },
   "custom/power-profiles": {
      "exec": "bash $HOME/.config/scripts/waybar/power-profiles.sh",
      "interval": 1,
      "format": {},
      "tooltip-format": "",
      "return-type": "json",

      "on-click": "bash $HOME/.config/scripts/menu.sh -P"

   },
   "bluetooth": {
      "format": " {status}",
      "format-no-controller": "",
      "format-connected": "󰂲 connected",
      "format-connected-battery": " connected {battery}%",
      "on-click": "bash $HOME/.config/scripts/kitty.sh --class floating-program bluetui"
   },
   "pulseaudio": {
      "format": "{icon} {volume}%",
      "format-bluetooth": "󰂰 {volume}%",
      "format-bluetooth-muted": "󰂰 muted",
      "format-muted": " muted",
      "format-icons": {
         "default": ["", "", ""]
      },
      "on-click": "bash $HOME/.config/scripts/kitty.sh --class floating-program wiremix"
   },
   "network": {
      "format-wifi": "󰖩 on",
      "format-ethernet": "󰈀 on",
      "format-disconnected": "󰖪 off",

      "on-click": "bash $HOME/.config/scripts/kitty.sh --class floating-program sudo nmtui &"
   },
   "tray": {
   },
   "clock": {
      "interval": 1,
      "timezone": "Europe/Zurich",
      "format": " {:%I:%M %p}",
      "format-alt": " {:%I:%M:%S %p, %b %d, %a, %d.%m.%Y}",
      "tooltip-format": " {:%I:%M:%S %p eu(%H:%M:%S), %b %d, %a, eu(%d.%m.%Y) us(%m.%d.%Y)}"
   },
   "battery": {
      "format": "{icon} {capacity}%",
      "format-full": "{icon} {capacity}%",
      "format-charging": "󱐋 {capacity}%",
      "format-plugged": "󱐋 {capacity}%",

      "format-icons": ["󱟩", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
   }
}
