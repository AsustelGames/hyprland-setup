* {
    text-color: #eaeaf0;
    background-color: transparent;
}

window {
    fullscreen: true;

    padding: 15px 0px 15px 15px;  


    padding: 0px;
}

mainbox {
    background-color: #2123377d;
    border-radius: 5px;
    padding: 0px;
    children: [listview];
}

listview {
    layout: horizontal;
    padding: 5px;
    lines: 9;
    spacing: 5px;
}

inputbar {
    padding: 0px;
    
    background-image: url("~/.config/rofi/bg.png");
    background-position: south;
    padding: 10px 0px 10px 10px;    
}

element {
    padding: 6px;
    border-radius: 5px;
}

element selected {
    background-color: #1586DFFF;
}

element-icon {
    size: 20px;
}

inputbar {
    enabled: false;
}
