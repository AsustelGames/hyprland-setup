hl.config({
  general = {
    gaps_in = {{ .root.decoration.gaps_in }},
    gaps_out = {{ .root.decoration.gaps_out }},

    border_size = {{ .root.decoration.border_size }},

    col = {
      active_border = "rgba({{ strings.TrimPrefix "#" .root.colors.gui.main.primary }}FF)",
      inactive_border = "rgba({{ strings.TrimPrefix "#" .root.colors.gui.main.secondary }}FF)",
    },
  },

  decoration = {
    --screen_shader = "~/.config/hypr/looks/bloom.frag",

    rounding = {{ .root.decoration.border_radius }},
    rounding_power = {{ .root.decoration.rounding_power }},

    active_opacity = {{ .root.decoration.active_opacity }},
    inactive_opacity = {{ .root.decoration.inactive_opacity }},

    dim_inactive = {{ .root.decoration.dim_inactive }},
    dim_strength = {{ .root.decoration.dim_strength }},

    shadow = {
      enabled = {{ .root.decoration.shadow.enabled }},
      range = {{ .root.decoration.shadow.range }},
      render_power = {{ .root.decoration.shadow.render_power }},
      color = "rgba({{ strings.TrimPrefix "#" .root.colors.gui.extra.color0 }}ee)",
    },

    blur = {
      enabled = {{ .root.decoration.blur.enabled }},
      size = {{ .root.decoration.blur.size }},
      passes = {{ .root.decoration.blur.passes }},
      noise = {{ .root.decoration.blur.noise }},
      vibrancy = {{ .root.decoration.blur.vibrancy }},
      vibrancy_darkness = {{ .root.decoration.blur.vibrancy_darkness }},
      brightness = {{ .root.decoration.blur.brightness }},
      popups = true,
      special = true,
    },

    glow = {
      enabled = true,
      render_power = 3,
      range = 5,
      color = "rgba({{ strings.TrimPrefix "#" .root.colors.gui.main.primary }}FF)",
      color_inactive = "rgba({{ strings.TrimPrefix "#" .root.colors.gui.main.secondary }}FF)",
    },

    motion_blur = {
      enabled = false,
      samples = 7,
    },

  },
})

hl.window_rule({
  name = "kitty-opacity",
  match = {
    class = "kitty",
  },
  opacity = "0.9 0.8",
})

hl.layer_rule({
  name = "rofi-blur",
  match = {
    namespace = "rofi",
  },
  blur = true,
  ignore_alpha = 0.1,
})

hl.layer_rule({
  name = "waybar-blur",
  match = {
    namespace = "waybar",
  },
  blur = true,
  ignore_alpha = 0.7,
})

hl.layer_rule({
  name = "quickshell-blur",
  match = {
    namespace = "quickshell",
  },
  blur = true,
  ignore_alpha = 0.5,
})
