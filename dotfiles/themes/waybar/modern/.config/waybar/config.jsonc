// -*- mode: jsonc -*-

{
    "position": "top",
    "height": 40,
    "spacing": 5,


    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "tray"
    ],
    "modules-right": [
        "bluetooth",
        "pulseaudio",
        "network",
        "clock",
        "battery"
    ],
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "warp-on-scroll": false,
        "format": "{name}"
    },
    "tray": {

    },
    "bluetooth": {
        "format": "  {status} ",
        "format-connected": " 󰂲 connected ",
        "format-connected-battery": " connected {battery}%",
        "on-click": "hyprctl dispatch exec '[float]' kitty bluetui"
    },
    "pulseaudio": {
        "format": " {icon} {volume}% ",
        "format-bluetooth": " 󰂰 {volume}% ",
        "format-bluetooth-muted": " 󰂰 muted ",
        "format-muted": "  muted ",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "hyprctl dispatch exec '[float]' kitty wiremix"
    },
    "network": {
        "format-wifi": " 󰖩 on ",
        "format-ethernet": " 󰈀 on ",
        "format-disconnected": " 󰖪 off  ",

        "on-click": "hyprctl dispatch exec '[float]' kitty sudo nmtui &"
    },
    "clock": {
        "interval": 1,
        "timezone": "Europe/Zurich",
        "format": "  {:%I:%M %p} ",
        "format-alt": "  {:%I:%M:%S %p, %b %d, %a, %d.%m.%Y} ",
        "tooltip-format": " {:%I:%M:%S %p eu(%H:%M), %b %d, %a, eu(%d.%m.%Y) us(%m.%d.%Y)}"
    },
    "battery": {
        "format": " {icon} {capacity}% ",
        "format-full": "{ icon} {capacity}% ",
        "format-charging": " 󱐋 {capacity}% ",
        "format-plugged": " 󱐋 {capacity}% ",

        "format-icons": ["󱟩", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    }
}
